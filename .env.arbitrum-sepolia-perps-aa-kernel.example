# Copy to ignored .env.arbitrum-sepolia-perps-aa-kernel and populate before running
# packages/perps-aa/script/DeployPletherKernelVerifyingPaymaster.s.sol. Never commit private keys.
ARB_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Governance and sponsorship limits (PAYMASTER_OWNER must differ from SPONSOR_SIGNER)
PAYMASTER_OWNER=
SPONSOR_SIGNER=
MAX_SPONSORED_COST_WEI=
KERNEL_PAYMASTER_POLICY_ID=

# Reviewed Arbitrum Sepolia Kernel v4 + EntryPoint v0.9 qualification profile
# EntryPoint v0.9 is pinned in script to 0x433709009B8330FDa32311DF1C2AFA402eD8D009
KERNEL_ENTRY_POINT_CODE_HASH=
KERNEL_FACTORY=
KERNEL_FACTORY_CODE_HASH=
KERNEL_IMPLEMENTATION=
KERNEL_IMPLEMENTATION_CODE_HASH=
KERNEL_ROOT_VALIDATOR=
KERNEL_ROOT_VALIDATOR_CODE_HASH=
KERNEL_PROXY_RUNTIME_CODE_HASH=
KERNEL_SAMPLE_OWNER=
